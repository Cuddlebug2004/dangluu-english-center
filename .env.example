# Database dùng chung với app Quản lý nhân sự
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Hai khóa này phải giống cấu hình bên app Quản lý nhân sự, tối thiểu 32 byte
LEARNING_CCCD_HMAC_SECRET=replace-with-a-random-secret-at-least-32-bytes
LEARNING_INTERNAL_SECRET=replace-with-another-random-secret-at-least-32-bytes

# URL chính thức, dùng để kiểm tra Origin chống CSRF
PUBLIC_SITE_URL=https://dangluu-english-center.vercel.app

# Token của Vercel Blob store đặt ở chế độ private
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me
